# Copy to .env only if you need one of these. The reviewer path needs no .env at all.
# For the full ops stack run `make ops-secrets`, which writes a complete .env with random secrets.

# development | production. Production refuses to start without auth, SECRET_KEY, ALLOWED_HOSTS,
# FORCE_HTTPS, TRUSTED_PROXIES and METRICS_TOKEN.
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# none (development only) | local (LOCAL_USERS_FILE with argon2 hashes) | oidc (Microsoft Entra ID)
AUTH_MODE=none
LOCAL_USERS_FILE=
SECRET_KEY=
SESSION_TTL_MINUTES=60
ALLOWED_HOSTS=
FORCE_HTTPS=false
TRUSTED_PROXIES=
METRICS_TOKEN=

# Microsoft Entra ID (AUTH_MODE=oidc). App roles: HeadOfSales, Admin, HeadOfRegion.<Region>, BrandManager.<Brand>
OIDC_TENANT_ID=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

# Data and limits
DATA_FILE=./sales.csv
DATA_DIR=./var
MAX_UPLOAD_MB=10
MAX_UPLOAD_ROWS=200000
RATE_LIMIT_PER_MINUTE=120

# Tanya data (chat). Offline by default. Set ANTHROPIC_API_KEY to enable Claude tool calling.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
LLM_TIMEOUT_S=20
LLM_MAX_OUTPUT_TOKENS=600
LLM_DAILY_TOKEN_BUDGET=200000
LLM_POLISH_SUMMARY=false
CHAT_RATE_PER_MINUTE=10
CHAT_MAX_QUESTION_CHARS=500
CHAT_MAX_TOOL_CALLS=4
CHAT_MEMORY_TURNS=3
LOG_QUESTION_TEXT=false

# Telegram (dry-run preview when empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Self-hosted Langfuse (tracing off when empty)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_SAMPLE_RATE=1.0

LOG_LEVEL=INFO
