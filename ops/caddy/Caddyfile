{
	admin off
	auto_https disable_redirects
	servers {
		trusted_proxies static private_ranges
	}
}

# Local TLS with Caddy's internal CA. On a VM, replace "localhost:8443" with the real host name and
# remove "tls internal" to get a public certificate, or point tls at the company certificate files.
https://localhost:8443 {
	tls internal
	encode gzip
	request_body {
		max_size 12MB
	}
	reverse_proxy 172.28.0.20:8000 {
		header_up X-Forwarded-Proto https
	}
	header -Server
	log {
		output stdout
		format json
	}
}
