# Alternative without Docker: the app in a virtualenv behind an existing reverse proxy (Caddy or nginx).
# Install:
#   sudo useradd --system --home /opt/dua-kelinci --shell /usr/sbin/nologin dkapp
#   cd /opt/dua-kelinci && python3.12 -m venv .venv && .venv/bin/pip install --require-hashes -r requirements-prod.lock
#   sudo install -m 600 -o dkapp /path/to/app.env /etc/dua-kelinci/app.env   (APP_ENV=production and the rest)
#   sudo cp ops/systemd/dua-kelinci-app.service /etc/systemd/system/ && sudo systemctl enable --now dua-kelinci-app
[Unit]
Description=Dua Kelinci Sales Insight (app only)
After=network-online.target
Wants=network-online.target

[Service]
User=dkapp
Group=dkapp
WorkingDirectory=/opt/dua-kelinci
EnvironmentFile=/etc/dua-kelinci/app.env
Environment=HOST=127.0.0.1 PORT=8000 DATA_DIR=/var/lib/dua-kelinci PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/dua-kelinci/.venv/bin/python app.py
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=20
StateDirectory=dua-kelinci
# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryMax=768M
CapabilityBoundingSet=
ReadWritePaths=/var/lib/dua-kelinci

[Install]
WantedBy=multi-user.target
